@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Check Your Email";
}

<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 bg-base-200">
    <div class="max-w-md w-full">
        <div class="bg-base-100 rounded-lg border border-base-300 p-8 text-center">
            <!-- Icon -->
            <div class="flex justify-center mb-6">
                <div class="bg-success/10 rounded-full p-4">
                    <i data-lucide="mail-check" class="w-10 h-10 text-success"></i>
                </div>
            </div>

            <!-- Title -->
            <h1 class="text-3xl font-bold text-base-content mb-2">Check Your Email</h1>
            <p class="text-base-content/70 mb-8">
                If an account with that email exists, we've sent a password reset link. Please check your inbox.
            </p>

            <a asp-page="./Login" class="btn btn-primary btn-lg btn-block gap-2">
                <i data-lucide="log-in" class="w-4 h-4"></i>
                Back to Login
            </a>
        </div>

        <!-- Footer -->
        <div class="text-center mt-6 text-sm text-base-content/50">
            <p><partial name="_CopyrightPartial" /></p>
        </div>
    </div>
</div>

@section Scripts {
    <script>lucide.createIcons();</script>
}
