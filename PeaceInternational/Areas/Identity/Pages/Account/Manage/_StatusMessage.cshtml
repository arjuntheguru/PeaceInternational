@model string

@if (!String.IsNullOrEmpty(Model))
{
    var isError = Model.StartsWith("Error");
    var alertClass = isError ? "alert-error" : "alert-success";
    var lucideIcon = isError ? "alert-circle" : "check-circle-2";

    <div class="alert @alertClass shadow-lg mb-6" role="alert">
        <div>
            <i data-lucide="@lucideIcon" class="w-5 h-5"></i>
            <span>@Model</span>
        </div>
    </div>
}
