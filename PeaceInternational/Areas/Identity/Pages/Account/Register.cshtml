@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 bg-base-200">
    <div class="max-w-md w-full">
        <div class="bg-base-100 rounded-lg border border-base-300 p-8">
            <!-- Title -->
            <div class="text-center mb-8">
                <h1 class="text-3xl font-bold text-base-content">Create Account</h1>
                <p class="text-base-content/70 mt-2">Join Peace International Tours</p>
            </div>

            <div asp-validation-summary="All" class="alert alert-error mb-4" role="alert" style="display: none;"></div>

            <form asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <!-- Email -->
                <div class="form-control mb-4">
                    <label class="label" asp-for="Input.Email">
                        <span class="label-text font-semibold">Email</span>
                    </label>
                    <label class="input flex items-center gap-2 bg-base-200">
                        <i data-lucide="mail" class="w-4 h-4 text-base-content/40"></i>
                        <input asp-for="Input.Email"
                               class="grow"
                               placeholder="Enter your email"
                               autofocus />
                    </label>
                    <label class="label">
                        <span asp-validation-for="Input.Email" class="label-text-alt text-error"></span>
                    </label>
                </div>

                <!-- Password -->
                <div class="form-control mb-4">
                    <label class="label" asp-for="Input.Password">
                        <span class="label-text font-semibold">Password</span>
                    </label>
                    <label class="input flex items-center gap-2 bg-base-200">
                        <i data-lucide="lock" class="w-4 h-4 text-base-content/40"></i>
                        <input asp-for="Input.Password"
                               class="grow"
                               placeholder="Choose a strong password" />
                    </label>
                    <label class="label">
                        <span asp-validation-for="Input.Password" class="label-text-alt text-error"></span>
                    </label>
                </div>

                <!-- Confirm Password -->
                <div class="form-control mb-6">
                    <label class="label" asp-for="Input.ConfirmPassword">
                        <span class="label-text font-semibold">Confirm Password</span>
                    </label>
                    <label class="input flex items-center gap-2 bg-base-200">
                        <i data-lucide="lock" class="w-4 h-4 text-base-content/40"></i>
                        <input asp-for="Input.ConfirmPassword"
                               class="grow"
                               placeholder="Re-enter your password" />
                    </label>
                    <label class="label">
                        <span asp-validation-for="Input.ConfirmPassword" class="label-text-alt text-error"></span>
                    </label>
                </div>

                <!-- Submit Button -->
                <div class="form-control">
                    <button type="submit" class="btn btn-primary btn-lg btn-block gap-2">
                        <i data-lucide="user-plus" class="w-4 h-4"></i>
                        Register
                    </button>
                </div>
            </form>

            <!-- Additional Links -->
            <div class="divider">OR</div>

            <div class="text-center">
                <p class="text-sm text-base-content/70">
                    Already have an account?
                    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="link link-primary font-semibold">
                        Sign in here
                    </a>
                </p>
            </div>
        </div>

        <!-- Footer -->
        <div class="text-center mt-6 text-sm text-base-content/50">
            <p><partial name="_CopyrightPartial" /></p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const validationSummary = document.querySelector('[asp-validation-summary]');
        if (validationSummary && validationSummary.querySelector('ul li')) {
            validationSummary.style.display = 'block';
        }
    </script>
    <script>lucide.createIcons();</script>
}
