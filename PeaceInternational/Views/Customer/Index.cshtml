@{
    ViewData["Title"] = "Customer";
}

<div class="drawer drawer-end">
    <input id="customer-drawer" type="checkbox" class="drawer-toggle" />
    <div class="drawer-content animate-fade-in">

        <!-- Modern Page Header -->
        <div class="page-header">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center">
                        <i data-lucide="users" class="w-5 h-5 text-primary"></i>
                    </div>
                    <div>
                        <h1 class="text-2xl font-bold text-base-content">Customer Management</h1>
                        <p class="text-sm text-base-content/60">Manage tour bookings and customer information</p>
                    </div>
                </div>
                <label for="customer-drawer" class="btn btn-accent gap-2 drawer-button">
                    <i data-lucide="plus" class="w-4 h-4"></i>
                    Add Customer
                </label>
            </div>
        </div>

        <!-- Search -->
        <div class="flex flex-wrap gap-3 mb-4">
            <label class="input input-bordered flex items-center gap-2 flex-1 min-w-[160px]">
                <i data-lucide="file-code" class="w-4 h-4 text-base-content/40 shrink-0"></i>
                <input type="text" id="searchFieldFileCode" placeholder="File Code..." class="grow" />
            </label>
            <label class="input input-bordered flex items-center gap-2 flex-1 min-w-[160px]">
                <i data-lucide="map-pin" class="w-4 h-4 text-base-content/40 shrink-0"></i>
                <input type="text" id="searchFieldTourName" placeholder="Tour Name..." class="grow" />
            </label>
            <label class="input input-bordered flex items-center gap-2 flex-1 min-w-[160px]">
                <i data-lucide="user" class="w-4 h-4 text-base-content/40 shrink-0"></i>
                <input type="text" id="searchFieldAgent" placeholder="Agent..." class="grow" />
            </label>
        </div>

        <!-- Customer Table -->
        <div class="surface-raised overflow-hidden">
            <div class="overflow-x-auto">
                <table class="table w-full" id="customerTable">
                    <thead>
                        <tr class="bg-base-200/50 border-b border-base-300">
                            <th class="text-xs font-semibold uppercase tracking-wider text-base-content/50">File Code</th>
                            <th class="text-xs font-semibold uppercase tracking-wider text-base-content/50">Tour Name</th>
                            <th class="text-xs font-semibold uppercase tracking-wider text-base-content/50">Country</th>
                            <th class="text-xs font-semibold uppercase tracking-wider text-base-content/50">Arrival</th>
                            <th class="text-xs font-semibold uppercase tracking-wider text-base-content/50">Departure</th>
                            <th class="text-xs font-semibold uppercase tracking-wider text-base-content/50">Agent</th>
                            <th class="text-xs font-semibold uppercase tracking-wider text-base-content/50">Agent Staff</th>
                            <th class="text-xs font-semibold uppercase tracking-wider text-base-content/50">Guide</th>
                            <th class="text-xs font-semibold uppercase tracking-wider text-base-content/50 text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        <tr>
                            <td colspan="9" class="text-center py-12">
                                <div class="loading loading-spinner loading-lg text-primary"></div>
                                <p class="mt-4">Loading customers...</p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div><!-- end drawer-content -->

    <!-- Drawer Panel -->
    <div class="drawer-side z-50">
        <label for="customer-drawer" class="drawer-overlay"></label>
        <div class="bg-base-100 w-full md:w-[600px] min-h-full shadow-2xl">
            <div class="sticky top-0 bg-base-100 border-b border-base-300 px-6 py-4 z-10">
                <div class="flex justify-between items-center">
                    <h2 class="text-lg font-semibold" id="customerTitle">Add Customer</h2>
                    <label for="customer-drawer" class="btn btn-ghost btn-sm btn-circle">
                        <i data-lucide="x" class="w-4 h-4"></i>
                    </label>
                </div>
            </div>

            <form id="customerForm" class="p-6">
                <input type="hidden" id="id" />

                <div class="space-y-4">
                    <!-- Tour Name -->
                    <div class="form-control">
                        <label class="label">
                            <span class="label-text font-medium text-base-content/70">Tour Name <span class="text-error">*</span></span>
                        </label>
                        <input type="text"
                               class="input input-bordered"
                               name="tourName"
                               id="tourName"
                               placeholder="Enter tour name"
                               oninput="this.value = this.value.toUpperCase()" />
                        <label class="label">
                            <span class="label-text-alt text-error" id="tourName-error"></span>
                        </label>
                    </div>

                    <!-- Country -->
                    <div class="form-control">
                        <label class="label">
                            <span class="label-text font-medium text-base-content/70">Country <span class="text-error">*</span></span>
                        </label>
                        <input type="text"
                               class="input input-bordered"
                               name="country"
                               id="country"
                               placeholder="Enter country"
                               oninput="this.value = this.value.toUpperCase()" />
                        <label class="label">
                            <span class="label-text-alt text-error" id="country-error"></span>
                        </label>
                    </div>

                    <!-- Dates -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="form-control">
                            <label class="label">
                                <span class="label-text font-medium text-base-content/70">Arrival Date</span>
                            </label>
                            <input type="date"
                                   class="input input-bordered"
                                   name="arrivalDate"
                                   id="arrivalDate" />
                            <label class="label">
                                <span class="label-text-alt text-error" id="arrivalDate-error"></span>
                            </label>
                        </div>
                        <div class="form-control">
                            <label class="label">
                                <span class="label-text font-medium text-base-content/70">Departure Date</span>
                            </label>
                            <input type="date"
                                   class="input input-bordered"
                                   name="departureDate"
                                   id="departureDate" />
                            <label class="label">
                                <span class="label-text-alt text-error" id="departureDate-error"></span>
                            </label>
                        </div>
                    </div>

                    <!-- Agent -->
                    <div class="form-control">
                        <label class="label">
                            <span class="label-text font-medium text-base-content/70">Agent</span>
                        </label>
                        <input type="text"
                               class="input input-bordered"
                               name="agent"
                               id="agent"
                               placeholder="Enter agent name" />
                    </div>

                    <!-- Agent Staff -->
                    <div class="form-control">
                        <label class="label">
                            <span class="label-text font-medium text-base-content/70">Agent Staff</span>
                        </label>
                        <input type="text"
                               class="input input-bordered"
                               name="agentStaff"
                               id="agentStaff"
                               placeholder="Enter agent staff name" />
                    </div>

                    <!-- Guide Name -->
                    <div class="form-control">
                        <label class="label">
                            <span class="label-text font-medium text-base-content/70">Guide Name</span>
                        </label>
                        <input type="text"
                               class="input input-bordered"
                               name="guideName"
                               id="guideName"
                               placeholder="Enter guide name" />
                    </div>
                </div>

                <!-- Actions -->
                <div class="flex gap-3 mt-8 sticky bottom-0 bg-base-100 pt-4 border-t border-base-300">
                    <button type="submit" class="btn btn-primary flex-1" id="btnSave">
                        <i data-lucide="save" class="w-4 h-4 mr-2"></i>
                        Save Customer
                    </button>
                    <label for="customer-drawer" class="btn btn-ghost flex-1">
                        <i data-lucide="x" class="w-4 h-4 mr-2"></i>
                        Cancel
                    </label>
                </div>
            </form>
        </div>
    </div><!-- end drawer-side -->
</div><!-- end drawer -->

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/customer.js"></script>
}
