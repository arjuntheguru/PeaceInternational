@{
    ViewData["Title"] = "Dashboard";
}

<div class="animate-fade-in space-y-6">

    <!-- Page Header -->
    <div class="page-header">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center">
                <i data-lucide="layout-dashboard" class="w-5 h-5 text-primary"></i>
            </div>
            <div>
                <h1 class="text-2xl font-bold text-base-content">Dashboard</h1>
                <p class="text-sm text-base-content/60">Welcome back — here's what's happening</p>
            </div>
        </div>
    </div>

    <!-- Stat Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <a asp-controller="Customer" asp-action="Index"
           class="surface-raised p-5 flex items-center gap-4 hover:shadow-md transition-shadow">
            <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
                <i data-lucide="users" class="w-5 h-5 text-primary"></i>
            </div>
            <div>
                <div class="text-2xl font-bold text-base-content" id="stat-customers">
                    <span class="loading loading-dots loading-xs"></span>
                </div>
                <div class="text-xs text-base-content/50 uppercase tracking-wider font-medium">Customers</div>
            </div>
        </a>

        <a asp-controller="Invoice" asp-action="Index"
           class="surface-raised p-5 flex items-center gap-4 hover:shadow-md transition-shadow">
            <div class="w-10 h-10 rounded-lg bg-info/10 flex items-center justify-center shrink-0">
                <i data-lucide="file-text" class="w-5 h-5 text-info"></i>
            </div>
            <div>
                <div class="text-2xl font-bold text-base-content" id="stat-invoices">
                    <span class="loading loading-dots loading-xs"></span>
                </div>
                <div class="text-xs text-base-content/50 uppercase tracking-wider font-medium">Invoices</div>
            </div>
        </a>

        <a asp-controller="ServiceVoucher" asp-action="Index"
           class="surface-raised p-5 flex items-center gap-4 hover:shadow-md transition-shadow">
            <div class="w-10 h-10 rounded-lg bg-success/10 flex items-center justify-center shrink-0">
                <i data-lucide="receipt" class="w-5 h-5 text-success"></i>
            </div>
            <div>
                <div class="text-2xl font-bold text-base-content" id="stat-vouchers">
                    <span class="loading loading-dots loading-xs"></span>
                </div>
                <div class="text-xs text-base-content/50 uppercase tracking-wider font-medium">Vouchers</div>
            </div>
        </a>

        <a asp-controller="TourCost" asp-action="Index"
           class="surface-raised p-5 flex items-center gap-4 hover:shadow-md transition-shadow">
            <div class="w-10 h-10 rounded-lg bg-warning/10 flex items-center justify-center shrink-0">
                <i data-lucide="dollar-sign" class="w-5 h-5 text-warning"></i>
            </div>
            <div>
                <div class="text-2xl font-bold text-base-content" id="stat-tourcosts">
                    <span class="loading loading-dots loading-xs"></span>
                </div>
                <div class="text-xs text-base-content/50 uppercase tracking-wider font-medium">Tour Costs</div>
            </div>
        </a>
    </div>

    <!-- Quick Actions -->
    <div class="surface-raised overflow-hidden">
        <div class="px-5 py-3 border-b border-base-300/60">
            <span class="text-xs font-semibold uppercase tracking-wider text-base-content/50">Quick Actions</span>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 divide-x divide-y md:divide-y-0 divide-base-300/60">
            <a asp-controller="Invoice" asp-action="AddEdit"
               class="flex flex-col items-center gap-2 p-6 hover:bg-base-200/50 transition-colors">
                <div class="w-10 h-10 rounded-lg bg-info/10 flex items-center justify-center">
                    <i data-lucide="plus" class="w-5 h-5 text-info"></i>
                </div>
                <span class="text-sm font-medium">New Invoice</span>
            </a>
            <a asp-controller="ServiceVoucher" asp-action="Index"
               class="flex flex-col items-center gap-2 p-6 hover:bg-base-200/50 transition-colors">
                <div class="w-10 h-10 rounded-lg bg-success/10 flex items-center justify-center">
                    <i data-lucide="receipt" class="w-5 h-5 text-success"></i>
                </div>
                <span class="text-sm font-medium">Service Vouchers</span>
            </a>
            <a asp-controller="TourCost" asp-action="AddEdit"
               class="flex flex-col items-center gap-2 p-6 hover:bg-base-200/50 transition-colors">
                <div class="w-10 h-10 rounded-lg bg-warning/10 flex items-center justify-center">
                    <i data-lucide="plane" class="w-5 h-5 text-warning"></i>
                </div>
                <span class="text-sm font-medium">New Tour Cost</span>
            </a>
            <a asp-controller="Customer" asp-action="Index"
               class="flex flex-col items-center gap-2 p-6 hover:bg-base-200/50 transition-colors">
                <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
                    <i data-lucide="users" class="w-5 h-5 text-primary"></i>
                </div>
                <span class="text-sm font-medium">Customers</span>
            </a>
        </div>
    </div>

    <!-- Rate Sheet Links -->
    <div class="surface-raised overflow-hidden">
        <div class="px-5 py-3 border-b border-base-300/60">
            <span class="text-xs font-semibold uppercase tracking-wider text-base-content/50">Rate Sheet</span>
        </div>
        <div class="flex flex-wrap gap-2 p-4">
            <a asp-controller="Hotel" asp-action="Index" class="btn btn-ghost btn-sm gap-2">
                <i data-lucide="building-2" class="w-4 h-4"></i> Hotels
            </a>
            <a asp-controller="Hotel" asp-action="HotelRoomRate" class="btn btn-ghost btn-sm gap-2">
                <i data-lucide="bed-double" class="w-4 h-4"></i> Room Rates
            </a>
            <a asp-controller="Guide" asp-action="Index" class="btn btn-ghost btn-sm gap-2">
                <i data-lucide="user-check" class="w-4 h-4"></i> Guides
            </a>
            <a asp-controller="Sector" asp-action="Index" class="btn btn-ghost btn-sm gap-2">
                <i data-lucide="map-pin" class="w-4 h-4"></i> Sectors
            </a>
            <a asp-controller="Transport" asp-action="Index" class="btn btn-ghost btn-sm gap-2">
                <i data-lucide="bus" class="w-4 h-4"></i> Transport
            </a>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        $.getJSON('/Home/GetStats', function (data) {
            document.getElementById('stat-customers').textContent = data.customers;
            document.getElementById('stat-invoices').textContent = data.invoices;
            document.getElementById('stat-vouchers').textContent = data.vouchers;
            document.getElementById('stat-tourcosts').textContent = data.tourcosts;
        });
    </script>
}
