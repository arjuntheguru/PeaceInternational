@{
    ViewData["Title"] = "Hotel Room Rate";
}

<div class="drawer drawer-end">
    <input id="roomrate-drawer" type="checkbox" class="drawer-toggle" />
    <div class="drawer-content animate-fade-in">

        <!-- Modern Page Header -->
        <div class="page-header">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center">
                        <i data-lucide="bed-double" class="w-5 h-5 text-primary"></i>
                    </div>
                    <div>
                        <h1 class="text-2xl font-bold text-base-content">Hotel Room Rates</h1>
                        <p class="text-sm text-base-content/60">Manage room rates and meal plans</p>
                    </div>
                </div>
                <label for="hotel-drawer" class="btn btn-primary gap-2 drawer-button">
                    <i data-lucide="plus" class="w-4 h-4"></i>
                    Add Room Rate
                </label>
            </div>
        </div>

        <!-- Search -->
        <div class="flex flex-wrap gap-3 mb-4">
            <label class="input input-bordered flex items-center gap-2 flex-1 min-w-[200px]">
                <i data-lucide="building-2" class="w-4 h-4 text-base-content/40 shrink-0"></i>
                <input type="text" id="searchField" placeholder="Hotel Name..." class="grow" />
            </label>
        </div>

        <!-- Room Rate Table -->
        <div class="surface-raised overflow-hidden">
            <div class="overflow-x-auto">
                <table class="table w-full" id="roomrateTable">
                    <thead>
                        <tr class="bg-base-200/50 border-b border-base-300">
                            <th class="text-xs font-semibold uppercase tracking-wider text-base-content/50">Hotel</th>
                            <th class="text-xs font-semibold uppercase tracking-wider text-base-content/50">Single Bed</th>
                            <th class="text-xs font-semibold uppercase tracking-wider text-base-content/50">Double Bed</th>
                            <th class="text-xs font-semibold uppercase tracking-wider text-base-content/50">Extra Bed</th>
                            <th class="text-xs font-semibold uppercase tracking-wider text-base-content/50">AP</th>
                            <th class="text-xs font-semibold uppercase tracking-wider text-base-content/50">MAP</th>
                            <th class="text-xs font-semibold uppercase tracking-wider text-base-content/50 text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        <tr>
                            <td colspan="7" class="text-center py-12">
                                <div class="loading loading-spinner loading-lg text-primary"></div>
                                <p class="mt-4">Loading room rates...</p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div><!-- end drawer-content -->

    <!-- Drawer Panel -->
    <div class="drawer-side z-50">
        <label for="roomrate-drawer" class="drawer-overlay"></label>
        <div class="bg-base-100 w-full md:w-[600px] min-h-full shadow-2xl">
            <div class="sticky top-0 bg-base-100 border-b border-base-300 px-6 py-4 z-10">
                <div class="flex justify-between items-center">
                    <h2 class="text-lg font-semibold" id="roomrateTitle">Add Room Rate</h2>
                    <label for="roomrate-drawer" class="btn btn-ghost btn-sm btn-circle">
                        <i data-lucide="x" class="w-4 h-4"></i>
                    </label>
                </div>
            </div>

            <form id="hotelRoomRateForm" class="p-6">
                <input type="hidden" id="id" />

                <div class="space-y-4">
                    <!-- Hotel Selection -->
                    <div class="form-control">
                        <label class="label">
                            <span class="label-text font-medium text-base-content/70">Hotel <span class="text-error">*</span></span>
                        </label>
                        <select class="select select-bordered" name="hotel" id="hotel">
                            <option disabled selected value="">Select Hotel</option>
                        </select>
                        <label class="label"><span class="label-text-alt text-error" id="hotel-error"></span></label>
                    </div>

                    <!-- Room Rates -->
                    <div class="px-3 py-2 bg-base-200/50 rounded-lg text-xs font-semibold uppercase tracking-wider text-base-content/50">Room Rates</div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="form-control">
                            <label class="label"><span class="label-text font-medium text-base-content/70">Single Bed <span class="text-error">*</span></span></label>
                            <input type="number" class="input input-bordered" name="singleBed" id="singleBed" placeholder="0.00" step="0.01" />
                            <label class="label"><span class="label-text-alt text-error" id="singleBed-error"></span></label>
                        </div>
                        <div class="form-control">
                            <label class="label"><span class="label-text font-medium text-base-content/70">Double Bed <span class="text-error">*</span></span></label>
                            <input type="number" class="input input-bordered" name="doubleBed" id="doubleBed" placeholder="0.00" step="0.01" />
                            <label class="label"><span class="label-text-alt text-error" id="doubleBed-error"></span></label>
                        </div>
                        <div class="form-control">
                            <label class="label"><span class="label-text font-medium text-base-content/70">Extra Bed <span class="text-error">*</span></span></label>
                            <input type="number" class="input input-bordered" name="extraBed" id="extraBed" placeholder="0.00" step="0.01" />
                            <label class="label"><span class="label-text-alt text-error" id="extraBed-error"></span></label>
                        </div>
                    </div>

                    <!-- Meal Plans -->
                    <div class="px-3 py-2 bg-base-200/50 rounded-lg text-xs font-semibold uppercase tracking-wider text-base-content/50">Meal Plans</div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="form-control">
                            <label class="label"><span class="label-text font-medium text-base-content/70">AP (American Plan) <span class="text-error">*</span></span></label>
                            <input type="number" class="input input-bordered" name="ap" id="ap" placeholder="0.00" step="0.01" />
                            <label class="label">
                                <span class="label-text-alt text-error" id="ap-error"></span>
                                <span class="label-text-alt">Breakfast + Lunch + Dinner</span>
                            </label>
                        </div>
                        <div class="form-control">
                            <label class="label"><span class="label-text font-medium text-base-content/70">MAP (Modified American Plan) <span class="text-error">*</span></span></label>
                            <input type="number" class="input input-bordered" name="map" id="map" placeholder="0.00" step="0.01" />
                            <label class="label">
                                <span class="label-text-alt text-error" id="map-error"></span>
                                <span class="label-text-alt">Breakfast + Lunch/Dinner</span>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Actions -->
                <div class="flex gap-3 mt-8 sticky bottom-0 bg-base-100 pt-4 border-t border-base-300">
                    <button type="submit" class="btn btn-primary flex-1" id="btnSave">
                        <i data-lucide="save" class="w-4 h-4 mr-2"></i>
                        Save Room Rate
                    </button>
                    <label for="roomrate-drawer" class="btn btn-ghost flex-1">
                        <i data-lucide="x" class="w-4 h-4 mr-2"></i>
                        Cancel
                    </label>
                </div>
            </form>
        </div>
    </div><!-- end drawer-side -->
</div><!-- end drawer -->

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/hotelRoomRate.js"></script>
}
