@{
    ViewData["Title"] = "Hotel";
}

<div class="drawer drawer-end">
    <input id="hotel-drawer" type="checkbox" class="drawer-toggle" />
    <div class="drawer-content animate-fade-in">

        <!-- Modern Page Header -->
        <div class="page-header">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center">
                        <i data-lucide="building-2" class="w-5 h-5 text-primary"></i>
                    </div>
                    <div>
                        <h1 class="text-2xl font-bold text-base-content">Hotel Management</h1>
                        <p class="text-sm text-base-content/60">Manage hotel information and rates</p>
                    </div>
                </div>
                <label for="hotel-drawer" class="btn btn-primary gap-2 drawer-button">
                    <i data-lucide="plus" class="w-4 h-4"></i>
                    Add Hotel
                </label>
            </div>
        </div>

        <!-- Search -->
        <div class="flex flex-wrap gap-3 mb-4">
            <label class="input input-bordered flex items-center gap-2 flex-1 min-w-[200px]">
                <i data-lucide="building-2" class="w-4 h-4 text-base-content/40 shrink-0"></i>
                <input type="text" id="searchField" placeholder="Hotel Name..." class="grow" />
            </label>
        </div>

        <!-- Hotel Table -->
        <div class="surface-raised overflow-hidden">
            <div class="overflow-x-auto">
                <table class="table w-full" id="hotelTable">
                    <thead>
                        <tr class="bg-base-200/50 border-b border-base-300">
                            <th class="text-xs font-semibold uppercase tracking-wider text-base-content/50">Hotel Name</th>
                            <th class="text-xs font-semibold uppercase tracking-wider text-base-content/50">Code</th>
                            <th class="text-xs font-semibold uppercase tracking-wider text-base-content/50">Category</th>
                            <th class="text-xs font-semibold uppercase tracking-wider text-base-content/50">Address</th>
                            <th class="text-xs font-semibold uppercase tracking-wider text-base-content/50">Phone</th>
                            <th class="text-xs font-semibold uppercase tracking-wider text-base-content/50 text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        <tr>
                            <td colspan="6" class="text-center py-12">
                                <div class="loading loading-spinner loading-lg text-primary"></div>
                                <p class="mt-4">Loading hotels...</p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div id="paginationContainer"></div>
        </div>

    </div><!-- end drawer-content -->

    <!-- Drawer Panel -->
    <div class="drawer-side z-50">
        <label for="hotel-drawer" class="drawer-overlay"></label>
        <div class="bg-base-100 w-full md:w-[600px] min-h-full shadow-2xl">
            <div class="sticky top-0 bg-base-100 border-b border-base-300 px-6 py-4 z-10">
                <div class="flex justify-between items-center">
                    <h2 class="text-lg font-semibold" id="hotelTitle">Add Hotel</h2>
                    <label for="hotel-drawer" class="btn btn-ghost btn-sm btn-circle">
                        <i data-lucide="x" class="w-4 h-4"></i>
                    </label>
                </div>
            </div>

            <form id="hotelForm" class="p-6">
                <input type="hidden" id="id" />

                <div class="space-y-4">
                    <!-- Hotel Name -->
                    <div class="form-control">
                        <label class="label">
                            <span class="label-text font-medium text-base-content/70">Hotel Name <span class="text-error">*</span></span>
                        </label>
                        <input type="text" class="input input-bordered" name="name" id="name"
                               placeholder="Enter hotel name" oninput="this.value = this.value.toUpperCase()" />
                        <label class="label">
                            <span class="label-text-alt text-error" id="name-error"></span>
                        </label>
                    </div>

                    <!-- Code and Category -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="form-control">
                            <label class="label">
                                <span class="label-text font-medium text-base-content/70">Code <span class="text-error">*</span></span>
                            </label>
                            <input type="text" class="input input-bordered" name="code" id="code"
                                   placeholder="Hotel code" oninput="this.value = this.value.toUpperCase()" />
                            <label class="label">
                                <span class="label-text-alt text-error" id="code-error"></span>
                            </label>
                        </div>
                        <div class="form-control">
                            <label class="label">
                                <span class="label-text font-medium text-base-content/70">Category <span class="text-error">*</span></span>
                            </label>
                            <select class="select select-bordered" name="category" id="category">
                                <option disabled selected value="">Select Category</option>
                                <option value="A">Category A</option>
                                <option value="B">Category B</option>
                                <option value="C">Category C</option>
                            </select>
                            <label class="label">
                                <span class="label-text-alt text-error" id="category-error"></span>
                            </label>
                        </div>
                    </div>

                    <!-- Address -->
                    <div class="form-control">
                        <label class="label">
                            <span class="label-text font-medium text-base-content/70">Address <span class="text-error">*</span></span>
                        </label>
                        <input type="text" class="input input-bordered" name="address" id="address"
                               placeholder="Hotel address" oninput="this.value = this.value.toUpperCase()" />
                        <label class="label">
                            <span class="label-text-alt text-error" id="address-error"></span>
                        </label>
                    </div>

                    <!-- Phone Number -->
                    <div class="form-control">
                        <label class="label">
                            <span class="label-text font-medium text-base-content/70">Phone Number <span class="text-error">*</span></span>
                        </label>
                        <input type="tel" class="input input-bordered" name="phoneNo" id="phoneNo" placeholder="Phone number" />
                        <label class="label">
                            <span class="label-text-alt text-error" id="phoneNo-error"></span>
                        </label>
                    </div>
                </div>

                <!-- Actions -->
                <div class="flex gap-3 mt-8 sticky bottom-0 bg-base-100 pt-4 border-t border-base-300">
                    <button type="submit" class="btn btn-primary flex-1" id="btnSave">
                        <i data-lucide="save" class="w-4 h-4 mr-2"></i>
                        Save Hotel
                    </button>
                    <label for="hotel-drawer" class="btn btn-ghost flex-1">
                        <i data-lucide="x" class="w-4 h-4 mr-2"></i>
                        Cancel
                    </label>
                </div>
            </form>
        </div>
    </div><!-- end drawer-side -->
</div><!-- end drawer -->

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/hotel.js"></script>
}
