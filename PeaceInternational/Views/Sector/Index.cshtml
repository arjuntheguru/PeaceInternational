@{
    ViewData["Title"] = "Sector";
}

<div class="drawer drawer-end">
    <input id="sector-drawer" type="checkbox" class="drawer-toggle" />
    <div class="drawer-content animate-fade-in">

        <!-- Modern Page Header -->
        <div class="page-header">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center">
                        <i data-lucide="map-pin" class="w-5 h-5 text-primary"></i>
                    </div>
                    <div>
                        <h1 class="text-2xl font-bold text-base-content">Sector Management</h1>
                        <p class="text-sm text-base-content/60">Manage sectors and transportation rates by PAX</p>
                    </div>
                </div>
                <label for="sector-drawer" class="btn btn-accent gap-2 drawer-button">
                    <i data-lucide="plus" class="w-4 h-4"></i>
                    Add Sector
                </label>
            </div>
        </div>

        <!-- Search -->
        <div class="flex flex-wrap gap-3 mb-4">
            <label class="input input-bordered flex items-center gap-2 flex-1 min-w-[200px]">
                <i data-lucide="map-pin" class="w-4 h-4 text-base-content/40 shrink-0"></i>
                <input type="text" id="searchField" placeholder="Sector Name..." class="grow" />
            </label>
        </div>

        <!-- Sector Table -->
        <div class="surface-raised overflow-hidden">
            <div class="overflow-x-auto">
                <table class="table w-full" id="sectorTable">
                    <thead>
                        <tr class="bg-base-200/50 border-b border-base-300">
                            <th class="text-xs font-semibold uppercase tracking-wider text-base-content/50">Sector Name</th>
                            <th class="text-xs font-semibold uppercase tracking-wider text-base-content/50">Code</th>
                            <th class="text-xs font-semibold uppercase tracking-wider text-base-content/50">T1 (1-2)</th>
                            <th class="text-xs font-semibold uppercase tracking-wider text-base-content/50">T2 (3-5)</th>
                            <th class="text-xs font-semibold uppercase tracking-wider text-base-content/50">T3 (6-9)</th>
                            <th class="text-xs font-semibold uppercase tracking-wider text-base-content/50">T4 (10-18)</th>
                            <th class="text-xs font-semibold uppercase tracking-wider text-base-content/50">T5 (19-24)</th>
                            <th class="text-xs font-semibold uppercase tracking-wider text-base-content/50">T6 (25+)</th>
                            <th class="text-xs font-semibold uppercase tracking-wider text-base-content/50 text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        <tr>
                            <td colspan="9" class="text-center py-12">
                                <div class="loading loading-spinner loading-lg text-primary"></div>
                                <p class="mt-4">Loading sectors...</p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div><!-- end drawer-content -->

    <!-- Drawer Panel -->
    <div class="drawer-side z-50">
        <label for="sector-drawer" class="drawer-overlay"></label>
        <div class="bg-base-100 w-full md:w-[700px] min-h-full shadow-2xl">
            <div class="sticky top-0 bg-base-100 border-b border-base-300 px-6 py-4 z-10">
                <div class="flex justify-between items-center">
                    <h2 class="text-lg font-semibold" id="sectorTitle">Add Sector</h2>
                    <label for="sector-drawer" class="btn btn-ghost btn-sm btn-circle">
                        <i data-lucide="x" class="w-4 h-4"></i>
                    </label>
                </div>
            </div>

            <form id="sectorForm" class="p-6">
                <input type="hidden" id="id" />

                <div class="space-y-4">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="form-control">
                            <label class="label">
                                <span class="label-text font-medium text-base-content/70">Sector Name <span class="text-error">*</span></span>
                            </label>
                            <input type="text" class="input input-bordered" name="name" id="name"
                                   placeholder="Enter sector name" oninput="this.value = this.value.toUpperCase()" />
                            <label class="label">
                                <span class="label-text-alt text-error" id="name-error"></span>
                            </label>
                        </div>
                        <div class="form-control">
                            <label class="label">
                                <span class="label-text font-medium text-base-content/70">Code <span class="text-error">*</span></span>
                            </label>
                            <input type="text" class="input input-bordered" name="code" id="code"
                                   placeholder="Sector code" oninput="this.value = this.value.toUpperCase()" />
                            <label class="label">
                                <span class="label-text-alt text-error" id="code-error"></span>
                            </label>
                        </div>
                    </div>

                    <div class="px-3 py-2 bg-base-200/50 rounded-lg text-xs font-semibold uppercase tracking-wider text-base-content/50">Rates by PAX Tiers</div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="form-control">
                            <label class="label"><span class="label-text font-medium text-base-content/70">T1 (01-02 PAX) <span class="text-error">*</span></span></label>
                            <input type="number" class="input input-bordered" name="t1cost" id="t1cost" placeholder="0.00" step="0.01" />
                            <label class="label"><span class="label-text-alt text-error" id="t1cost-error"></span></label>
                        </div>
                        <div class="form-control">
                            <label class="label"><span class="label-text font-medium text-base-content/70">T2 (03-05 PAX) <span class="text-error">*</span></span></label>
                            <input type="number" class="input input-bordered" name="t2cost" id="t2cost" placeholder="0.00" step="0.01" />
                            <label class="label"><span class="label-text-alt text-error" id="t2cost-error"></span></label>
                        </div>
                        <div class="form-control">
                            <label class="label"><span class="label-text font-medium text-base-content/70">T3 (06-09 PAX) <span class="text-error">*</span></span></label>
                            <input type="number" class="input input-bordered" name="t3cost" id="t3cost" placeholder="0.00" step="0.01" />
                            <label class="label"><span class="label-text-alt text-error" id="t3cost-error"></span></label>
                        </div>
                        <div class="form-control">
                            <label class="label"><span class="label-text font-medium text-base-content/70">T4 (10-18 PAX) <span class="text-error">*</span></span></label>
                            <input type="number" class="input input-bordered" name="t4cost" id="t4cost" placeholder="0.00" step="0.01" />
                            <label class="label"><span class="label-text-alt text-error" id="t4cost-error"></span></label>
                        </div>
                        <div class="form-control">
                            <label class="label"><span class="label-text font-medium text-base-content/70">T5 (19-24 PAX) <span class="text-error">*</span></span></label>
                            <input type="number" class="input input-bordered" name="t5cost" id="t5cost" placeholder="0.00" step="0.01" />
                            <label class="label"><span class="label-text-alt text-error" id="t5cost-error"></span></label>
                        </div>
                        <div class="form-control">
                            <label class="label"><span class="label-text font-medium text-base-content/70">T6 (25+ PAX) <span class="text-error">*</span></span></label>
                            <input type="number" class="input input-bordered" name="t6cost" id="t6cost" placeholder="0.00" step="0.01" />
                            <label class="label"><span class="label-text-alt text-error" id="t6cost-error"></span></label>
                        </div>
                    </div>
                </div>

                <!-- Actions -->
                <div class="flex gap-3 mt-8 sticky bottom-0 bg-base-100 pt-4 border-t border-base-300">
                    <button type="submit" class="btn btn-primary flex-1" id="btnSave">
                        <i data-lucide="save" class="w-4 h-4 mr-2"></i>
                        Save Sector
                    </button>
                    <label for="sector-drawer" class="btn btn-ghost flex-1">
                        <i data-lucide="x" class="w-4 h-4 mr-2"></i>
                        Cancel
                    </label>
                </div>
            </form>
        </div>
    </div><!-- end drawer-side -->
</div><!-- end drawer -->

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/sector.js"></script>
}
