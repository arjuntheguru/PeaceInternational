@using Microsoft.AspNetCore.Http.Features

@{
    var consentFeature = Context.Features.Get<ITrackingConsentFeature>();
    var showBanner = !consentFeature?.CanTrack ?? false;
    var cookieString = consentFeature?.CreateConsentCookie();
}

@if (showBanner)
{
    <div id="cookieConsent" class="w-full px-4 pt-4">
        <div class="bg-base-100 border border-base-300 rounded-2xl shadow-lg px-5 py-4 flex items-center gap-4 max-w-7xl mx-auto">
            <i data-lucide="cookie" class="w-5 h-5 text-primary shrink-0"></i>
            <p class="text-sm text-base-content/70 flex-1">
                We use cookies to improve your experience.
                <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-primary hover:underline font-medium">Learn more</a>
            </p>
            <button id="cookieAcceptBtn" data-cookie-string="@cookieString"
                class="btn btn-primary btn-sm rounded-xl shrink-0">
                Accept
            </button>
        </div>
    </div>
    <script>
        (function () {
            var btn = document.getElementById('cookieAcceptBtn');
            btn.addEventListener('click', function () {
                document.cookie = btn.dataset.cookieString;
                document.getElementById('cookieConsent').remove();
            });
        })();
    </script>
}
