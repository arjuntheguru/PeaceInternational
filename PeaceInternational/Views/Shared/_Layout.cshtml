<!DOCTYPE html>
<html lang="en" data-theme="light" class="min-h-full bg-base-200">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Peace International Tours</title>

    <link rel="icon" type="image/svg+xml" href="~/img/favicon-dove.svg" />

    <!-- Tailwind CSS + Daisy UI -->
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />

    <!-- Inter Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-base-200 min-h-screen">

@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole("ADMIN");

    // Breadcrumb label map
    var breadcrumbLabel = controller switch {
        "Home" => "Dashboard",
        "Invoice" => action == "AddEdit" ? "Invoice / Edit" : "Invoice",
        "ServiceVoucher" => "Service Voucher",
        "TourCost" => action == "AddEdit" ? "Tour Cost / Edit" : action == "View" ? "Tour Cost / View" : "Tour Cost",
        "Customer" => "Customers",
        "Users" => "Users",
        "Hotel" => action == "HotelRoomRate" ? "Rate Sheet / Room Rate" : "Rate Sheet / Hotel",
        "Guide" => "Rate Sheet / Guide",
        "Sector" => "Rate Sheet / Sector",
        "Transport" => "Transport",
        _ => controller
    };

    bool IsActive(string ctrl, string act = "") =>
        controller.Equals(ctrl, StringComparison.OrdinalIgnoreCase) &&
        (string.IsNullOrEmpty(act) || action.Equals(act, StringComparison.OrdinalIgnoreCase));

    string NavLink(string ctrl, string act = "Index") =>
        IsActive(ctrl, act) ? "sidebar-link sidebar-link-active" : "sidebar-link";
}

<!-- Mobile Drawer (DaisyUI) -->
<div class="@(isAuthenticated ? "drawer lg:drawer-open min-h-screen" : "min-h-screen")">
    @if (isAuthenticated)
    {
        <input id="sidebar-drawer" type="checkbox" class="drawer-toggle" />
    }

    <!-- Page Content -->
    <div class="drawer-content bg-base-200 flex flex-col min-h-screen">

        <!-- Top Bar -->
        <header class="sticky top-0 z-30 bg-base-100 h-14 flex items-center px-4 gap-3 shadow-sm">
            <!-- Mobile hamburger -->
            @if (isAuthenticated)
            {
                <label for="sidebar-drawer" class="btn btn-ghost btn-sm btn-square lg:hidden" aria-label="Open navigation">
                    <i data-lucide="menu" class="w-5 h-5"></i>
                </label>
            }

            <!-- Breadcrumb -->
            <div class="flex items-center gap-2 text-sm flex-1">
                <span class="text-base-content/40">
                    <i data-lucide="home" class="w-3.5 h-3.5 inline-block"></i>
                </span>
                <span class="text-base-content/40">/</span>
                <span class="font-medium text-base-content">@breadcrumbLabel</span>
            </div>

            <!-- Right side: theme toggle + user -->
            <div class="flex items-center gap-2">
                <label class="swap swap-rotate btn btn-ghost btn-sm btn-circle">
                    <input type="checkbox" id="theme-toggle" class="hidden" />
                    <svg class="swap-on w-4 h-4 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M5.64,17l-.71.71a1,1,0,0,0,0,1.41,1,1,0,0,0,1.41,0l.71-.71A1,1,0,0,0,5.64,17ZM5,12a1,1,0,0,0-1-1H3a1,1,0,0,0,0,2H4A1,1,0,0,0,5,12Zm7-7a1,1,0,0,0,1-1V3a1,1,0,0,0-2,0V4A1,1,0,0,0,12,5ZM5.64,7.05a1,1,0,0,0,.7.29,1,1,0,0,0,.71-.29,1,1,0,0,0,0-1.41l-.71-.71A1,1,0,0,0,4.93,6.34Zm12,.29a1,1,0,0,0,.7-.29l.71-.71a1,1,0,1,0-1.41-1.41L17,5.64a1,1,0,0,0,0,1.41A1,1,0,0,0,17.66,7.34ZM21,11H20a1,1,0,0,0,0,2h1a1,1,0,0,0,0-2Zm-9,8a1,1,0,0,0-1,1v1a1,1,0,0,0,2,0V20A1,1,0,0,0,12,19ZM18.36,17A1,1,0,0,0,17,18.36l.71.71a1,1,0,0,0,1.41,0,1,1,0,0,0,0-1.41ZM12,6.5A5.5,5.5,0,1,0,17.5,12,5.51,5.51,0,0,0,12,6.5Zm0,9A3.5,3.5,0,1,1,15.5,12,3.5,3.5,0,0,1,12,15.5Z"/></svg>
                    <svg class="swap-off w-4 h-4 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M21.64,13a1,1,0,0,0-1.05-.14,8.05,8.05,0,0,1-3.37.73A8.15,8.15,0,0,1,9.08,5.49a8.59,8.59,0,0,1,.25-2A1,1,0,0,0,8,2.36,10.14,10.14,0,1,0,22,14.05,1,1,0,0,0,21.64,13Zm-9.5,6.69A8.14,8.14,0,0,1,7.08,5.22v.27A10.15,10.15,0,0,0,17.22,15.63a9.79,9.79,0,0,0,2.1-.22A8.11,8.11,0,0,1,12.14,19.73Z"/></svg>
                </label>
                <partial name="_LoginPartial" />
            </div>
        </header>

        <!-- Cookie Consent -->
        <partial name="_CookieConsentPartial" />

        <!-- Main Content -->
        <main class="flex-1 px-4 py-6 max-w-7xl w-full mx-auto">
            @RenderBody()
        </main>

        <!-- Footer -->
        <footer class="px-6 py-3 text-xs text-base-content/40 border-t border-base-300/40">
            <partial name="_CopyrightPartial" /> &mdash; Powered by Voberry Technologies
        </footer>
    </div>

    @if (isAuthenticated)
    {
        <!-- Sidebar -->
        <div class="drawer-side z-40">
            <label for="sidebar-drawer" class="drawer-overlay" aria-label="Close navigation"></label>
            <aside class="w-60 min-h-full bg-base-100 flex flex-col">

            <!-- Logo -->
            <div class="h-14 flex items-center justify-center px-4 shrink-0">
                <a asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/img/logo.JPG" alt="Peace International" class="h-14 w-auto" data-light-logo="/img/logo.JPG" data-dark-logo="/img/logo.png" />
                </a>
            </div>

            <!-- Nav -->
            <nav class="flex-1 overflow-y-auto py-3 px-2 space-y-0.5">

                <a asp-area="" asp-controller="Home" asp-action="Index" class="@NavLink("Home")">
                    <i data-lucide="layout-dashboard" class="w-4 h-4 shrink-0"></i>
                    Dashboard
                </a>

                <div class="pt-3 pb-1 px-2">
                    <span class="text-[10px] font-semibold uppercase tracking-widest text-base-content/40">Operations</span>
                </div>

                <a asp-area="" asp-controller="Invoice" asp-action="Index" class="@NavLink("Invoice")">
                    <i data-lucide="file-text" class="w-4 h-4 shrink-0"></i>
                    Invoice
                </a>

                <a asp-area="" asp-controller="ServiceVoucher" asp-action="Index" class="@NavLink("ServiceVoucher")">
                    <i data-lucide="receipt" class="w-4 h-4 shrink-0"></i>
                    Service Voucher
                </a>

                <a asp-area="" asp-controller="TourCost" asp-action="Index" class="@NavLink("TourCost")">
                    <i data-lucide="dollar-sign" class="w-4 h-4 shrink-0"></i>
                    Tour Cost
                </a>

                <a asp-area="" asp-controller="Customer" asp-action="Index" class="@NavLink("Customer")">
                    <i data-lucide="users" class="w-4 h-4 shrink-0"></i>
                    Customers
                </a>

                <div class="pt-3 pb-1 px-2">
                    <span class="text-[10px] font-semibold uppercase tracking-widest text-base-content/40">Rate Sheet</span>
                </div>

                <a asp-area="" asp-controller="Hotel" asp-action="Index" class="@NavLink("Hotel", "Index")">
                    <i data-lucide="building-2" class="w-4 h-4 shrink-0"></i>
                    Hotel
                </a>

                <a asp-area="" asp-controller="Hotel" asp-action="HotelRoomRate" class="@NavLink("Hotel", "HotelRoomRate")">
                    <i data-lucide="bed-double" class="w-4 h-4 shrink-0"></i>
                    Room Rate
                </a>

                <a asp-area="" asp-controller="Guide" asp-action="Index" class="@NavLink("Guide")">
                    <i data-lucide="user-check" class="w-4 h-4 shrink-0"></i>
                    Guide
                </a>

                <a asp-area="" asp-controller="Sector" asp-action="Index" class="@NavLink("Sector")">
                    <i data-lucide="map-pin" class="w-4 h-4 shrink-0"></i>
                    Sector
                </a>

                @if (isAdmin)
                {
                    <div class="pt-3 pb-1 px-2">
                        <span class="text-[10px] font-semibold uppercase tracking-widest text-base-content/40">Admin</span>
                    </div>

                    <a asp-area="" asp-controller="Users" asp-action="Index" class="@NavLink("Users")">
                        <i data-lucide="shield-check" class="w-4 h-4 shrink-0"></i>
                        Users
                    </a>
                }

            </nav>
            </aside>
        </div>
    }
</div>

<!-- Confirm Dialog -->
<dialog id="confirmModal" class="modal">
    <div class="modal-box max-w-sm">
        <h3 class="font-semibold text-base" id="confirmTitle">Confirm</h3>
        <p class="text-sm text-base-content/70 mt-2" id="confirmMessage">Are you sure?</p>
        <div class="modal-action mt-4">
            <button class="btn btn-error btn-sm" id="confirmOk">Delete</button>
            <form method="dialog"><button class="btn btn-ghost btn-sm">Cancel</button></form>
        </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button>close</button></form>
</dialog>

<!-- Scripts -->
<environment include="Development">
    <script src="~/lib/jquery/dist/jquery.js"></script>
</environment>
<environment exclude="Development">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js"
            asp-fallback-src="~/lib/jquery/dist/jquery.min.js"
            asp-fallback-test="window.jQuery"
            crossorigin="anonymous"
            integrity="sha256-FgpCb/KJQlLNfOu91ta32o/NMZxltwRo8QtmkMRdAu8=">
    </script>
</environment>

<script src="~/js/customValidation.js" asp-append-version="true"></script>
<script src="~/lib/jquery.nepaliDatePicker.min.js" asp-append-version="true"></script>
<script src="~/lib/handlebars-v4.4.3.js" asp-append-version="true"></script>
<script src="~/lib/customHelper.js" asp-append-version="true"></script>
<script src="~/lib/html2canvas.js" asp-append-version="true"></script>
<script src="~/js/toast-helper.js" asp-append-version="true"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

<script>
    // Theme toggle
    const themeToggle = document.getElementById('theme-toggle');
    const htmlEl = document.documentElement;
    const savedTheme = localStorage.getItem('theme') || 'light';
    htmlEl.setAttribute('data-theme', savedTheme);
    if (savedTheme === 'dark') themeToggle.checked = true;

    const siteLogoEl = document.querySelector('[data-light-logo]');
    const updateLogo = (theme) => {
        if (!siteLogoEl) return;
        siteLogoEl.src = theme === 'dark' ? siteLogoEl.dataset.darkLogo : siteLogoEl.dataset.lightLogo;
    };
    updateLogo(savedTheme);

    themeToggle.addEventListener('change', function () {
        const theme = this.checked ? 'dark' : 'light';
        htmlEl.setAttribute('data-theme', theme);
        localStorage.setItem('theme', theme);
        updateLogo(theme);
    });

    // Initialize Lucide icons
    lucide.createIcons();
</script>

@RenderSection("Scripts", required: false)
</body>
</html>
