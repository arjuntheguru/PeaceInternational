@{
    ViewData["Title"] = "Users";
}

<div class="drawer drawer-end">
    <input id="user-drawer" type="checkbox" class="drawer-toggle" />
    <input id="password-drawer" type="checkbox" class="drawer-toggle" />
    <div class="drawer-content animate-fade-in">

        <!-- Modern Page Header -->
        <div class="page-header">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center">
                        <i data-lucide="shield-check" class="w-5 h-5 text-primary"></i>
                    </div>
                    <div>
                        <h1 class="text-2xl font-bold text-base-content">User Management</h1>
                        <p class="text-sm text-base-content/60">Manage system users and their roles</p>
                    </div>
                </div>
                <label for="user-drawer" class="btn btn-accent gap-2 drawer-button">
                    <i data-lucide="plus" class="w-4 h-4"></i>
                    Add User
                </label>
            </div>
        </div>

        <!-- Search -->
        <div class="flex flex-wrap gap-3 mb-4">
            <label class="input input-bordered flex items-center gap-2 flex-1 min-w-[200px]">
                <i data-lucide="user" class="w-4 h-4 text-base-content/40 shrink-0"></i>
                <input type="text" id="searchField" placeholder="Username..." class="grow" />
            </label>
        </div>

        <!-- Users Table -->
        <div class="surface-raised overflow-hidden">
            <div class="overflow-x-auto">
                <table class="table w-full" id="usersTable">
                    <thead>
                        <tr class="bg-base-200/50 border-b border-base-300">
                            <th class="text-xs font-semibold uppercase tracking-wider text-base-content/50">Username</th>
                            <th class="text-xs font-semibold uppercase tracking-wider text-base-content/50">Phone Number</th>
                            <th class="text-xs font-semibold uppercase tracking-wider text-base-content/50">Role</th>
                            <th class="text-xs font-semibold uppercase tracking-wider text-base-content/50 text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        <tr>
                            <td colspan="4" class="text-center py-12">
                                <div class="loading loading-spinner loading-lg text-primary"></div>
                                <p class="mt-4">Loading users...</p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div><!-- end drawer-content -->

    <!-- Add User Drawer Panel -->
    <div class="drawer-side z-50">
        <label for="user-drawer" class="drawer-overlay"></label>
        <div class="bg-base-100 w-full md:w-[600px] min-h-full shadow-2xl">
            <div class="sticky top-0 bg-base-100 border-b border-base-300 px-6 py-4 z-10">
                <div class="flex justify-between items-center">
                    <h2 class="text-lg font-semibold" id="userTitle">Add User</h2>
                    <label for="user-drawer" class="btn btn-ghost btn-sm btn-circle">
                        <i data-lucide="x" class="w-4 h-4"></i>
                    </label>
                </div>
            </div>

            <form id="usersForm" class="p-6">
                <input type="hidden" id="id" />

                <div class="space-y-4">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="form-control">
                            <label class="label">
                                <span class="label-text font-medium text-base-content/70">Username <span class="text-error">*</span></span>
                            </label>
                            <input type="text" class="input input-bordered" name="username" id="username" placeholder="Enter username" />
                            <label class="label"><span class="label-text-alt text-error" id="username-error"></span></label>
                        </div>
                        <div class="form-control">
                            <label class="label">
                                <span class="label-text font-medium text-base-content/70">Email <span class="text-error">*</span></span>
                            </label>
                            <input type="email" class="input input-bordered" name="email" id="email" placeholder="user@example.com" />
                            <label class="label"><span class="label-text-alt text-error" id="email-error"></span></label>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="form-control">
                            <label class="label">
                                <span class="label-text font-medium text-base-content/70">Phone Number <span class="text-error">*</span></span>
                            </label>
                            <input type="text" class="input input-bordered" name="phoneNo" id="phoneNo" placeholder="Phone number" />
                            <label class="label"><span class="label-text-alt text-error" id="phoneNo-error"></span></label>
                        </div>
                        <div class="form-control">
                            <label class="label">
                                <span class="label-text font-medium text-base-content/70">Role <span class="text-error">*</span></span>
                            </label>
                            <select class="select select-bordered" name="role" id="role">
                                <option disabled selected value="">Select Role</option>
                                <option value="Admin">Admin</option>
                                <option value="User">User</option>
                            </select>
                            <label class="label"><span class="label-text-alt text-error" id="role-error"></span></label>
                        </div>
                    </div>

                    <div class="px-3 py-2 bg-base-200/50 rounded-lg text-xs font-semibold uppercase tracking-wider text-base-content/50">Password</div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="form-control">
                            <label class="label">
                                <span class="label-text font-medium text-base-content/70">Password <span class="text-error">*</span></span>
                            </label>
                            <input type="password" class="input input-bordered" name="password" id="password" placeholder="Enter password" />
                            <label class="label"><span class="label-text-alt text-error" id="password-error"></span></label>
                        </div>
                        <div class="form-control">
                            <label class="label">
                                <span class="label-text font-medium text-base-content/70">Confirm Password <span class="text-error">*</span></span>
                            </label>
                            <input type="password" class="input input-bordered" name="confirmPassword" id="confirmPassword" placeholder="Confirm password" />
                            <label class="label"><span class="label-text-alt text-error" id="confirmPassword-error"></span></label>
                        </div>
                    </div>
                </div>

                <div class="flex gap-3 mt-8 sticky bottom-0 bg-base-100 pt-4 border-t border-base-300">
                    <button type="submit" class="btn btn-primary flex-1" id="btnSave">
                        <i data-lucide="save" class="w-4 h-4 mr-2"></i>
                        Save User
                    </button>
                    <label for="user-drawer" class="btn btn-ghost flex-1">
                        <i data-lucide="x" class="w-4 h-4 mr-2"></i>
                        Cancel
                    </label>
                </div>
            </form>
        </div>
    </div><!-- end drawer-side (user) -->
</div><!-- end drawer (user) -->

<!-- Change Password Drawer (separate drawer root) -->
<div class="drawer drawer-end">
    <input id="password-drawer" type="checkbox" class="drawer-toggle" />
    <div class="drawer-content"></div>
    <div class="drawer-side z-50">
        <label for="password-drawer" class="drawer-overlay"></label>
        <div class="bg-base-100 w-full md:w-[500px] min-h-full shadow-2xl">
            <div class="sticky top-0 bg-base-100 border-b border-base-300 px-6 py-4 z-10">
                <div class="flex justify-between items-center">
                    <h2 class="text-lg font-semibold">Change Password</h2>
                    <label for="password-drawer" class="btn btn-ghost btn-sm btn-circle">
                        <i data-lucide="x" class="w-4 h-4"></i>
                    </label>
                </div>
            </div>

            <form id="changePasswordForm" class="p-6">
                <input type="hidden" id="userId" />

                <div class="space-y-4">
                    <div class="form-control">
                        <label class="label">
                            <span class="label-text font-medium text-base-content/70">Username</span>
                        </label>
                        <input type="text" class="input input-bordered" id="changePwdUserName" disabled />
                    </div>
                    <div class="form-control">
                        <label class="label">
                            <span class="label-text font-medium text-base-content/70">New Password <span class="text-error">*</span></span>
                        </label>
                        <input type="password" class="input input-bordered" name="newPassword" id="newPassword" placeholder="Enter new password" />
                        <label class="label"><span class="label-text-alt text-error" id="newPassword-error"></span></label>
                    </div>
                    <div class="form-control">
                        <label class="label">
                            <span class="label-text font-medium text-base-content/70">Confirm New Password <span class="text-error">*</span></span>
                        </label>
                        <input type="password" class="input input-bordered" name="confirmNewPassword" id="confirmNewPassword" placeholder="Confirm new password" />
                        <label class="label"><span class="label-text-alt text-error" id="confirmNewPassword-error"></span></label>
                    </div>
                </div>

                <div class="flex gap-3 mt-8 sticky bottom-0 bg-base-100 pt-4 border-t border-base-300">
                    <button type="submit" class="btn btn-primary flex-1" id="btnSaveNewPassword">
                        <i data-lucide="save" class="w-4 h-4 mr-2"></i>
                        Save Password
                    </button>
                    <label for="password-drawer" class="btn btn-ghost flex-1">
                        <i data-lucide="x" class="w-4 h-4 mr-2"></i>
                        Cancel
                    </label>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/users.js"></script>
}
